{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MariaDB Config",
  "description": "Simplified database instance declarations for GitOps IDP",
  "type": "object",
  "required": ["instances"],
  "additionalProperties": false,
  "properties": {
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/instance"
      }
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "required": ["name", "owner", "spec"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unique instance name, used as the MariaDB CR name"
        },
        "owner": {
          "type": "string",
          "description": "Owning application or team identifier"
        },
        "spec": {
          "$ref": "#/$defs/spec"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["instance_type", "storage_size"],
      "additionalProperties": false,
      "properties": {
        "instance_type": {
          "type": "string",
          "enum": ["small", "medium", "large"],
          "description": "Predefined resource tier"
        },
        "storage_size": {
          "type": "string",
          "pattern": "^[0-9]+(Gi|Ti)$",
          "description": "Storage size in Kubernetes quantity format"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "description": "MariaDB version (e.g. 11.4, 10.11)",
          "default": "11.4"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Database Config",
  "description": "Simplified database resource declarations for GitOps IDP",
  "type": "object",
  "required": ["resources"],
  "additionalProperties": false,
  "properties": {
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["name", "owner", "lifecycle", "instances"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unique resource name (e.g. mariadb-001)"
        },
        "owner": {
          "type": "string",
          "description": "Owning application (transform appends -devs for group ref)"
        },
        "lifecycle": {
          "type": "string",
          "enum": ["production", "staging", "development"],
          "description": "Resource lifecycle stage"
        },
        "version": {
          "type": "string",
          "description": "Database engine version (applies to all instances)"
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/instance"
          }
        }
      }
    },
    "instance": {
      "type": "object",
      "required": ["site", "stage"],
      "additionalProperties": false,
      "properties": {
        "site": {
          "type": "string",
          "description": "Deployment site (e.g. us-west-1)"
        },
        "stage": {
          "type": "string",
          "enum": ["test", "staging", "production"],
          "description": "Deployment stage"
        },
        "version": {
          "type": "string",
          "description": "Database engine version"
        },
        "instance_type": {
          "type": "string",
          "enum": ["small", "medium", "large"],
          "description": "Resource tier"
        },
        "storage_size": {
          "type": "string",
          "pattern": "^[0-9]+(Gi|Ti)$",
          "description": "Storage size in Kubernetes quantity format"
        }
      }
    }
  }
}
